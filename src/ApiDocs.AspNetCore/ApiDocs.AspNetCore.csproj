<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ApiDocs.AspNetCore</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Vendored, self-contained browser assets shipped inside the assembly.
